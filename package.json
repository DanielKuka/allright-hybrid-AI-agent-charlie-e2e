{
  "name": "charlie-quiz-hybrid-v2",
  "version": "1.0.0",
  "private": true,
  "description": "AI-driven Charlie funnel navigation with deterministic business verification",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=unit",
    "test:unit": "playwright test --project=unit",
    "test:browser-contract": "playwright test --project=browser-contract",
    "check": "npm run typecheck && npm run test:unit && npm run test:browser-contract",
    "test:e2e": "playwright test tests/charlie-hybrid.spec.ts --project=chromium --workers=1",
    "test:e2e:headed": "playwright test tests/charlie-hybrid.spec.ts --project=chromium --headed --workers=1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
